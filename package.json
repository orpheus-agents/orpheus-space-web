{
  "name": "orpheus-space-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "lint": "eslint . --max-warnings=0 && vue-tsc --noEmit",
    "e2e": "playwright test",
    "generate:api": "node scripts/api.mjs generate",
    "api:update": "node scripts/api.mjs update",
    "api:check": "node scripts/api.mjs check",
    "api:verify": "node scripts/api.mjs verify",
    "test:tools": "node --test scripts/*.test.mjs",
    "knip": "knip",
    "stack:start": "node scripts/stack.mjs start",
    "stack:start:saml": "node scripts/stack.mjs start-saml",
    "stack:stop": "node scripts/stack.mjs stop",
    "test:integration": "node scripts/stack.mjs test",
    "audit": "npm audit --audit-level=moderate",
    "lint:api": "redocly lint --config redocly.yaml api/upstream.yaml"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "cronstrue": "^3.27.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.11.1",
    "lucide-vue-next": "^0.475.0",
    "markdown-it": "^14.3.2",
    "vue": "^3.5.13",
    "vue-i18n": "11.1.12",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/devtools-types": "^11.4.12",
    "@playwright/test": "^1.59.1",
    "@redocly/cli": "^2.54.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "jsdom": "^26.0.0",
    "knip": "^6.11.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.8"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
